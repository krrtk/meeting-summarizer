# ── Groq ────────────────────────────────────────────────────────────────────
# Get your free API key at https://console.groq.com
GROQ_API_KEY=

# Whisper model used for audio transcription (do not change unless Groq deprecates it)
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Chat model used for meeting summarization/extraction
GROQ_LLM_MODEL=openai/gpt-oss-120b

# ── Audio ────────────────────────────────────────────────────────────────────
# Maximum allowed audio upload size in megabytes
MAX_AUDIO_SIZE_MB=100

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite file path (relative to the directory where uvicorn is started).
# The tables are created automatically on first startup — no migrations needed.
DATABASE_URL=sqlite:///./meeting_summarizer.db

# ── CORS / Origins ───────────────────────────────────────────────────────────
# The origin of the Next.js frontend dev server
FRONTEND_ORIGIN=http://localhost:3000

# ── Frontend (Next.js) ───────────────────────────────────────────────────────
# URL the browser uses to reach the FastAPI backend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
